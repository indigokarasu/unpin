{
  "manifest_version": 3,
  "name": "Unpin",
  "version": "1.2.0",
  "description": "Download every image on a Pinterest board, with a folder for each section.",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Unpin: download this board",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "popup.html",
        "popup.css",
        "popup.js",
        "icons/*"
      ],
      "matches": [
        "https://*.pinterest.com/*",
        "https://*.pinterest.ca/*",
        "https://*.pinterest.co.uk/*",
        "https://*.pinterest.de/*",
        "https://*.pinterest.fr/*",
        "https://*.pinterest.it/*",
        "https://*.pinterest.es/*",
        "https://*.pinterest.jp/*",
        "https://*.pinterest.at/*",
        "https://*.pinterest.ch/*",
        "https://*.pinterest.dk/*",
        "https://*.pinterest.cl/*",
        "https://*.pinterest.co.kr/*",
        "https://*.pinterest.com.au/*",
        "https://*.pinterest.com.mx/*",
        "https://*.pinterest.nz/*",
        "https://*.pinterest.pt/*",
        "https://*.pinterest.se/*"
      ]
    }
  ]
}
